---
// Rökprovets ram: sidhuvud med meny och telefon, main och sidfot, så att varje testsida uppfyller byggstandarden.
import Bas from '../layouts/Bas.astro';
import Brodsmulor from './Brodsmulor.astro';
interface Props { titel: string; beskrivning: string; noindex?: boolean; sida?: string }
const { titel, beskrivning, noindex = false, sida } = Astro.props;
---
<Bas titel={titel} beskrivning={beskrivning} tema="#0b57d0" noindex={noindex}>
  <style is:global>
    body { font-family: system-ui, sans-serif; margin: 0; color: #1a1a1a; background: #fff; }
    header, main, footer { max-width: 40rem; margin: 0 auto; padding: 1rem; line-height: 1.6; }
    a { color: #0b57d0; display: inline-block; min-height: 24px; line-height: 24px; }
    label { display: block; font-weight: 600; }
    input, textarea, button { font: inherit; min-height: 44px; }
  </style>
  <header>
    <nav aria-label="Huvudmeny"><a href="/">Start</a> · <a href="/om/">Om provet</a> · <a href="/kontakt/">Kontakt</a></nav>
    <p><a href="tel:+46701234567">Ring 070-123 45 67</a></p>
  </header>
  {sida && <Brodsmulor sida={sida} />}
  <main id="innehall"><slot /></main>
  <footer><p>Rökprov, fiktiv testsajt.</p></footer>
</Bas>
