---
import Bas from '../../layouts/Bas.astro';
import Brodsmulor from '../../components/Brodsmulor.astro';
---
<Bas titel="Om rökprovet" beskrivning="Varför testsidan finns och vad den prövar i kontrollkedjan." tema="#0b57d0">
  <style is:global>
    body { font-family: var(--typ-brodtext-familj); font-size: var(--typ-brodtext-storlek); margin: 0; color: var(--farg-text); background: var(--farg-yta); }
    header, main, footer { max-width: var(--spalt-1440-maxbredd); margin: 0 auto; padding: var(--avstand-m); line-height: var(--typ-brodtext-radavstand); }
    a { color: var(--farg-accent); display: inline-block; min-height: 24px; line-height: 24px; }
  </style>
  <header>
    <nav aria-label="Huvudmeny"><a href="/">Start</a> · <a href="/om/">Om provet</a> · <a href="/kontakt/">Kontakt</a></nav>
    <p><a href="tel:+46701234567">Ring 070-123 45 67</a></p>
  </header>
  <Brodsmulor sida="Om provet" />
  <main id="innehall">
    <h1>Om provet</h1>
    <p>Provet bygger sajten, serverar den lokalt och kör axe, Lighthouse, SEO-kontrollen, byggstandarden och copykontrollen.</p>
    <p><a href="/">Tillbaka</a></p>
  </main>
  <footer><p>Rökprov, fiktiv testsajt.</p></footer>
</Bas>
