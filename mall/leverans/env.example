# Workerns inställningar (wrangler.jsonc). Hemligheter läggs med `npx wrangler secret put NAMN`, aldrig i repot.
# RESEND_API_KEY är en hemlighet. Lokalt kan den läggas i .dev.vars, som aldrig checkas in.
RESEND_API_KEY=
# I wrangler.jsonc, vars: mottagaren (verksamhetens adress; flera med komma) och avsändaren (en verifierad adress på
# verksamhetens domän).
FORFRAGAN_TILL=
FORFRAGAN_FRAN=
