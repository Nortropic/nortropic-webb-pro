---
// Brödsmulor för en undersida (byggstandarden 7.3): synlig navigering "Du är här" och BreadcrumbList i JSON-LD ur
// samma lista. Startsidan kommer först, sidan själv sist och utan länk. Utseendet skrivs för verksamheten.
// Placeras mellan sidhuvudet och <main> (GOV.UK): då hoppar länken "Till innehållet" över dem, och varken
// länkarna eller JSON-LD hamnar i huvudinnehållet (ägarens dom L4).
//   <Brodsmulor sida="Tillbyggnad" />   eller   <Brodsmulor steg={[{ namn: 'Tjänster', href: '/tjanster/' }]} sida="Tak" />
interface Steg { namn: string; href: string }
interface Props { sida: string; steg?: Steg[] }
const { sida, steg = [] } = Astro.props;
const alla = [{ namn: 'Start', href: '/' }, ...steg];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [...alla, { namn: sida, href: Astro.url.pathname }].map((s, i) => ({
    '@type': 'ListItem', position: i + 1, name: s.namn, item: new URL(s.href, Astro.site).href,
  })),
};
---
<nav class="brodsmulor" aria-label="Du är här">
  <ol>
    {alla.map((s) => <li><a href={s.href}>{s.namn}</a></li>)}
    <li><span aria-current="page">{sida}</span></li>
  </ol>
</nav>
<script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />

<style>
  /* Neutral grund som bygget skriver över: en rad med ›, ingen numrering, klickytor minst 24 px (byggstandarden 3.3). */
  .brodsmulor ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; }
  .brodsmulor li + li::before { content: '›'; margin-right: 0.5rem; }
  .brodsmulor a, .brodsmulor span { display: inline-block; min-height: 24px; line-height: 24px; }
</style>
