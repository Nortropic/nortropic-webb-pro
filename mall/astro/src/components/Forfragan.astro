---
// Skriftlig förfrågan (byggstandarden 6: en skriftlig väg bredvid telefonen).
// Fungerar med vanlig POST utan JavaScript; honeypot och tidsfälla mot spam. Mottagaren är /api/forfragan/ (med snedstreck: sajten har avslutande snedstreck, och utan det svarar Vercel 308 och webbläsaren skickar inskicket två gånger): i demon
// svarar provets och dashboardens server och visar /tack/ utan att spara eller skicka något; vid lansering tar en
// serverfunktion över med ett eget kontrakt (kunskap/forfragan.md): ett fältfel ger en felsida med texten bevarad, inte
// #forfragan-saknas. Bygget stylar formuläret och skriver etiketterna i
// verksamhetens ord; fältnamnen och fällorna ändras inte.
interface Props {
  fraga?: string; // etiketten för meddelandet, i verksamhetens ord
  knapp?: string;
  saknas?: string; // felbeskedet när ett ofullständigt inskick kommer tillbaka, i verksamhetens ord
  telefon?: string; // numret som väg vidare i felbeskedet, som tel-adress: +46...
  telefonText?: string;
  felNamn?: string; // beskeden vid ett tomt fält, i verksamhetens ord (byggstandarden 6.2)
  felTelefon?: string;
  felTelefonFormat?: string; // beskedet när numret har bokstäver eller är för kort (byggstandarden 6.2, WCAG 3.3.1)
  felMeddelande?: string;
  felBild?: string; // beskedet när bilden inte kan tas emot (över 4 MB eller inte en bild), i verksamhetens ord
}
const { fraga = 'Vad vill du ha hjälp med?', knapp = 'Skicka förfrågan',
  saknas = 'Namn, telefon och vad du vill ha hjälp med behövs. Fyll i dem och skicka igen.', telefon, telefonText,
  felNamn = 'Skriv ditt namn.', felTelefon = 'Skriv ett nummer vi kan ringa.',
  felTelefonFormat = 'Skriv numret med siffror, till exempel 070-123 45 67.', felMeddelande = 'Skriv vad du vill ha hjälp med.',
  felBild = 'Bilden kunde inte tas emot: den får vara högst 4 MB och en vanlig bildfil (JPEG, PNG, WebP, HEIC, HEIF, GIF eller AVIF). Skicka utan bild eller med en mindre.' } = Astro.props;
---
<form class="forfragan" id="forfragan" action="/api/forfragan/" method="post" enctype="multipart/form-data">
  <!-- Felbesked utan JavaScript: mottagaren skickar ett ofullständigt inskick till #forfragan-saknas, och :target visar det. -->
  <p id="forfragan-saknas" class="ff-saknas" tabindex="-1" role="alert">{saknas}{telefon && <> Eller ring <a href={`tel:${telefon}`}>{telefonText || telefon}</a>.</>}</p>
  <!-- En bild som inte kunde tas emot: mottagaren skickar tillbaka till #forfragan-bild (eget besked, aldrig "saknas"). -->
  <p id="forfragan-bild" class="ff-saknas" tabindex="-1" role="alert">{felBild}</p>
  <p>
    <label for="ff-namn">Namn</label>
    <!-- Beskedet står i HTML:en och visas av CSS (:user-invalid) när besökaren lämnat fältet eller försökt skicka, också utan
         JavaScript (byggstandarden 6.2; backloggen 2026-10-03). Med JavaScript töms spannen vid laddning och fylls vid invalid. -->
    <input id="ff-namn" name="namn" type="text" autocomplete="name" required maxlength="100" aria-describedby="ff-namn-fel" data-saknas={felNamn} />
    <span id="ff-namn-fel" class="ff-fel">{felNamn}</span>
  </p>
  <p>
    <label for="ff-telefon">Telefon</label>
    <!-- Siffror, mellanslag, +, - och parenteser, minst sex tecken: "abc" går inte igenom (byggstandarden 6.2). Utan JavaScript
         visar CSS formatbeskedet (ff-telefon-format) när fältet inte är tomt (placeholder-shown) och saknas-beskedet annars. -->
    <input id="ff-telefon" name="telefon" type="tel" inputmode="tel" autocomplete="tel" required maxlength="40" placeholder=" "
      pattern="(?=.*[0-9])[0-9+\-\(\) ]{6,40}" aria-describedby="ff-telefon-fel ff-telefon-format" data-saknas={felTelefon} data-format={felTelefonFormat} />
    <span id="ff-telefon-fel" class="ff-fel">{felTelefon}</span>
    <span id="ff-telefon-format" class="ff-fel ff-format">{felTelefonFormat}</span>
  </p>
  <p>
    <label for="ff-meddelande">{fraga}</label>
    <textarea id="ff-meddelande" name="meddelande" rows="5" required maxlength="4000" aria-describedby="ff-meddelande-fel" data-saknas={felMeddelande}></textarea>
    <span id="ff-meddelande-fel" class="ff-fel">{felMeddelande}</span>
  </p>
  <p class="ff-fil">
    <!-- Egen knapp i stället för webbläsarens "Choose File / No file chosen"; etiketten öppnar väljaren även utan JS. -->
    <label for="ff-bild">Bild på jobbet (valfritt)</label>
    <input id="ff-bild" class="ff-filfalt" name="bild" type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif,image/gif,image/avif" aria-describedby="ff-filnamn ff-bild-fel" data-for-stor={felBild} />
    <label for="ff-bild" class="ff-filknapp">Välj bild</label>
    <span id="ff-filnamn" class="ff-filnamn">Ingen bild vald</span>
    <span id="ff-bild-fel" class="ff-fel"></span>
  </p>
  <p class="ff-falla" aria-hidden="true">
    <label for="ff-webbplats">Lämna fältet tomt</label>
    <input id="ff-webbplats" name="webbplats" type="text" tabindex="-1" autocomplete="off" />
  </p>
  <input type="hidden" name="fylltid" value="" />
  <p class="ff-integritet">
    <slot name="integritet">Vi använder uppgifterna bara för att svara på din förfrågan.{' '}<a href="/integritet/">Så hanterar vi personuppgifter</a>.</slot>
  </p>
  <button type="submit">{knapp}</button>
</form>

<script>
  // Tidsfällan mäts på EN klocka, webbläsarens, från laddning till inskick, och skickas som varaktighet i ms
  // (kunskap/formularsakerhet.md, princip b). Utan JavaScript står fältet tomt och mottagaren godtar inskicket.
  const start = performance.now();
  for (const f of document.querySelectorAll<HTMLFormElement>('form.forfragan')) {
    // Svenska besked som text vid fältet (aria-describedby) i stället för webbläsarens bubbla, som följer
    // webbläsarens språk (byggstandarden 6.2, WCAG 3.3.1). Första felaktiga fältet får fokus. Utan JavaScript visar
    // CSS (:user-invalid) beskeden som står i HTML:en; med JavaScript töms de här och fylls vid invalid, så att
    // beskrivningen inte läses upp i förväg. POST fungerar som förut.
    for (const s of f.querySelectorAll<HTMLElement>('.ff-fel')) s.textContent = '';
    let forsta = true;
    for (const falt of f.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required][data-saknas]')) {
      const fel = document.getElementById((falt.getAttribute('aria-describedby') || '').split(' ')[0]);
      falt.addEventListener('invalid', (e) => {
        e.preventDefault();
        const besked = (falt.validity.patternMismatch && falt.dataset.format) || falt.dataset.saknas || '';
        falt.setCustomValidity(besked);
        falt.setAttribute('aria-invalid', 'true');
        if (fel) fel.textContent = besked;
        if (forsta) { forsta = false; falt.focus(); setTimeout(() => { forsta = true; }); }
      });
      falt.addEventListener('input', () => {
        falt.setCustomValidity('');
        if (falt.validity.valid) { falt.removeAttribute('aria-invalid'); if (fel) fel.textContent = ''; }
      });
    }
    const fil = f.querySelector<HTMLInputElement>('input[type="file"]');
    const namn = f.querySelector<HTMLElement>('.ff-filnamn');
    fil?.addEventListener('change', () => {
      if (namn) namn.textContent = fil.files?.[0]?.name || 'Ingen bild vald';
      // storleken prövas före inskicket: en bild över 4 MB stoppas här med beskedet vid fältet (granskningen 2026-10-05, fynd 4)
      const forStor = (fil.files?.[0]?.size || 0) > 4_000_000;
      fil.setCustomValidity(forStor ? fil.dataset.forStor || '' : '');
      const fel = document.getElementById('ff-bild-fel');
      if (fel) fel.textContent = forStor ? fil.dataset.forStor || '' : '';
      if (forStor) fil.setAttribute('aria-invalid', 'true'); else fil.removeAttribute('aria-invalid');
    });
    f.addEventListener('submit', () => {
      const tid = f.querySelector<HTMLInputElement>('input[name="fylltid"]');
      if (tid) tid.value = String(Math.round(performance.now() - start));
      const b = f.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (b) { b.disabled = true; b.textContent = 'Skickar …'; }
    });
  }
</script>

<style>
  .ff-falla { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .ff-saknas { display: none; }
  .ff-saknas:target { display: block; }
  /* Beskedet vid fältet: dolt tills fältet är :user-invalid (besökaren har lämnat det eller försökt skicka), utan JavaScript;
     med JavaScript styr aria-invalid. Telefonfältet: formatbeskedet när fältet inte är tomt, annars saknas-beskedet. */
  .ff-fel { display: none; font-weight: 600; }
  :user-invalid + .ff-fel, [aria-invalid="true"] + .ff-fel, .ff-filfalt[aria-invalid="true"] ~ .ff-fel { display: block; }
  #ff-telefon:user-invalid:not(:placeholder-shown) + .ff-fel { display: none; }
  #ff-telefon:user-invalid:not(:placeholder-shown) ~ .ff-format { display: block; }
  #ff-telefon[aria-invalid="true"] ~ .ff-format { display: none; }
  /* Filfältet: knappen är etiketten; själva fältet är osynligt men fokuserbart, och fokus syns på knappen. */
  .ff-filfalt { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; }
  .ff-filknapp { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1rem; border: 1px solid currentColor; cursor: pointer; }
  .ff-filfalt:focus-visible + .ff-filknapp { outline: 3px solid currentColor; outline-offset: 2px; }
  .ff-filnamn { margin-left: 0.75rem; }
</style>
