---
// Skriftlig förfrågan (byggstandarden 6, ägarens dom L1: "standarden ska inte tillåta att 'ring' är enda vägen").
// Fungerar med vanlig POST utan JavaScript; honeypot och tidsfälla mot spam. Mottagaren är /api/forfragan: i demon
// svarar provets och dashboardens server och visar /tack/ utan att spara eller skicka något; vid lansering tar en
// serverfunktion över med samma kontrakt (kunskap/forfragan.md). Bygget stylar formuläret och skriver etiketterna i
// verksamhetens ord; fältnamnen och fällorna ändras inte.
interface Props {
  fraga?: string; // etiketten för meddelandet, i verksamhetens ord
  knapp?: string;
  saknas?: string; // felbeskedet när ett ofullständigt inskick kommer tillbaka, i verksamhetens ord
  telefon?: string; // numret som väg vidare i felbeskedet, som tel-adress: +46...
  telefonText?: string;
}
const { fraga = 'Vad vill du ha hjälp med?', knapp = 'Skicka förfrågan',
  saknas = 'Namn, telefon och vad du vill ha hjälp med behövs. Fyll i dem och skicka igen.', telefon, telefonText } = Astro.props;
---
<form class="forfragan" id="forfragan" action="/api/forfragan" method="post" enctype="multipart/form-data">
  <!-- Felbesked utan JavaScript: mottagaren skickar ett ofullständigt inskick till #forfragan-saknas, och :target visar det. -->
  <p id="forfragan-saknas" class="ff-saknas" tabindex="-1" role="alert">{saknas}{telefon && <> Eller ring <a href={`tel:${telefon}`}>{telefonText || telefon}</a>.</>}</p>
  <p>
    <label for="ff-namn">Namn</label>
    <input id="ff-namn" name="namn" type="text" autocomplete="name" required maxlength="100" />
  </p>
  <p>
    <label for="ff-telefon">Telefon</label>
    <input id="ff-telefon" name="telefon" type="tel" inputmode="tel" autocomplete="tel" required maxlength="40" />
  </p>
  <p>
    <label for="ff-meddelande">{fraga}</label>
    <textarea id="ff-meddelande" name="meddelande" rows="5" required maxlength="4000"></textarea>
  </p>
  <p>
    <label for="ff-bild">Bild på jobbet (valfritt)</label>
    <input id="ff-bild" name="bild" type="file" accept="image/*" />
  </p>
  <p class="ff-falla" aria-hidden="true">
    <label for="ff-webbplats">Lämna fältet tomt</label>
    <input id="ff-webbplats" name="webbplats" type="text" tabindex="-1" autocomplete="off" />
  </p>
  <input type="hidden" name="fylltid" value="" />
  <p class="ff-integritet">
    <slot name="integritet">Vi använder uppgifterna bara för att svara på din förfrågan.
    <a href="/integritet/">Så hanterar vi personuppgifter</a>.</slot>
  </p>
  <button type="submit">{knapp}</button>
</form>

<script>
  // Tidsfällan mäts på EN klocka, webbläsarens, från laddning till inskick, och skickas som varaktighet i ms
  // (kunskap/formularsakerhet.md, princip b). Utan JavaScript står fältet tomt och mottagaren godtar inskicket.
  const start = performance.now();
  for (const f of document.querySelectorAll<HTMLFormElement>('form.forfragan')) {
    f.addEventListener('submit', () => {
      const tid = f.querySelector<HTMLInputElement>('input[name="fylltid"]');
      if (tid) tid.value = String(Math.round(performance.now() - start));
      const b = f.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (b) { b.disabled = true; b.textContent = 'Skickar …'; }
    });
  }
</script>

<style>
  .ff-falla { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .ff-saknas { display: none; }
  .ff-saknas:target { display: block; }
</style>
