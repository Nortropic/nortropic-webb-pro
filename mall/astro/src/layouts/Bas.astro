---
// Bara det tekniska varje sida behöver (byggstandarden 2.3, 5.1, 7.1). All design, typografi och struktur skrivs för
// just den här verksamheten. Filerna public/favicon.svg, public/apple-touch-icon.png (180×180) och
// public/delningsbild.png (1200×630) skapar bygget själv: favicon ur verksamhetens märke, de två andra med
// node kontroller/ikoner.mjs. Sidans <main> ska ha id="innehall" så att skiplänken landar rätt.
interface Props {
  titel: string;
  beskrivning: string;
  tema: string; // theme-color, verksamhetens bärande färg
  delningsbild?: string;
  noindex?: boolean; // 404-sidan: noindex och ingen canonical (byggstandarden 7.2)
  // Flerspråkighet (katalogens k18-flersprak): sidans språk och dess versioner på andra språk, med sidan själv. Utan dem
  // är sidan svensk och har inga alternate-länkar. Standardspråket (det första i listan) blir x-default.
  sprak?: string;
  alternativ?: { sprak: string; href: string }[];
}
import '../styles/design.css';  // CSS-variablerna ur DESIGN.md (kontroller/design.py --skriv); tom tills designen är skriven
const { titel, beskrivning, tema, delningsbild = '/delningsbild.png', noindex = false, sprak = 'sv', alternativ = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const bild = new URL(delningsbild, Astro.site).href;
const SPRAK = /^[a-z]{2}(-[A-Z]{2})?$/;  // ISO 639-1, ev. region enligt ISO 3166-1 (Googles krav på hreflang)
if (!SPRAK.test(sprak) || alternativ.some((a) => !SPRAK.test(a.sprak))) throw new Error(`Bas: ogiltig språkkod (${sprak})`);
if (alternativ.length && !alternativ.some((a) => a.sprak === sprak)) throw new Error('Bas: alternativen ska innehålla sidans eget språk');
const LOKAL: Record<string, string> = { sv: 'sv_SE', en: 'en_GB', fi: 'fi_FI', nb: 'nb_NO', da: 'da_DK', de: 'de_DE' };
const SKIPLANK: Record<string, string> = { sv: 'Hoppa till innehållet', en: 'Skip to content', fi: 'Siirry sisältöön', nb: 'Gå til innholdet', da: 'Gå til indholdet', de: 'Zum Inhalt springen' };
const grund = sprak.split('-')[0];
const versioner = noindex ? [] : alternativ.map((a) => ({ sprak: a.sprak, href: new URL(a.href, Astro.site).href }));
// Sökkonsolens verifiering (katalogens k05-search-console): exporten skriver src/verifiering.json ur verksamhetens
// VERKSAMHET.json (webb.sokkonsol_verifiering); taggen ska ligga kvar så länge egenskapen finns. Utan filen ingen tagg.
const verifiering = Object.values(import.meta.glob('../verifiering.json', { eager: true, import: 'default' }))[0] as { google?: unknown } | undefined;
const google = verifiering && typeof verifiering.google === 'string' && /^[A-Za-z0-9_-]{20,100}$/.test(verifiering.google) ? verifiering.google : null;
---
<!doctype html>
<html lang={sprak}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beskrivning} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {versioner.map((v) => <link rel="alternate" hreflang={v.sprak} href={v.href} />)}
    {versioner.length > 0 && <link rel="alternate" hreflang="x-default" href={versioner[0].href} />}
    <meta name="theme-color" content={tema} />
    {google && <meta name="google-site-verification" content={google} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    {LOKAL[grund] && <meta property="og:locale" content={LOKAL[grund]} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beskrivning} />
    <meta property="og:image" content={bild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <slot name="head" />
  </head>
  <body>
    <a class="skiplank" href="#innehall">{SKIPLANK[grund] || SKIPLANK.sv}</a>
    <slot />
  </body>
</html>

<style is:global>
  .skiplank { position: absolute; left: 0.5rem; top: -100%; padding: 0.75rem 1rem; background: #fff; color: #000; z-index: 1000; }
  .skiplank:focus { top: 0.5rem; }
  /* Byggstandarden 3.5: den som har bett om mindre rörelse får inga övergångar, animationer eller mjuk skroll. */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
  }
</style>
