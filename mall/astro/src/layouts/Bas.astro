---
// Bara det tekniska varje sida behöver (byggstandarden 2.3, 5.1, 7.1). All design, typografi och struktur skrivs för
// just den här verksamheten. Filerna public/favicon.svg, public/apple-touch-icon.png (180×180) och
// public/delningsbild.png (1200×630) skapar bygget själv: favicon ur verksamhetens märke, de två andra med
// node kontroller/ikoner.mjs. Sidans <main> ska ha id="innehall" så att skiplänken landar rätt.
interface Props {
  titel: string;
  beskrivning: string;
  tema: string; // theme-color, verksamhetens bärande färg
  delningsbild?: string;
  noindex?: boolean; // 404-sidan: noindex och ingen canonical (byggstandarden 7.2)
}
const { titel, beskrivning, tema, delningsbild = '/delningsbild.png', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const bild = new URL(delningsbild, Astro.site).href;
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titel}</title>
    <meta name="description" content={beskrivning} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content={tema} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beskrivning} />
    <meta property="og:image" content={bild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <slot name="head" />
  </head>
  <body>
    <a class="skiplank" href="#innehall">Hoppa till innehållet</a>
    <slot />
  </body>
</html>

<style is:global>
  .skiplank { position: absolute; left: 0.5rem; top: -100%; padding: 0.75rem 1rem; background: #fff; color: #000; z-index: 1000; }
  .skiplank:focus { top: 0.5rem; }
</style>
